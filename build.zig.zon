.{
    .name = .wasmcart,
    .version = "0.1.1",
    .minimum_zig_version = "0.16.0",

    // Generated by the toolchain and never changed by hand: together with the
    // name it is this package's globally unique identity, so editing it would
    // claim to be a different package.
    .fingerprint = 0x28859b89cbfecdb4,

    .dependencies = .{},

    // Only what a consumer needs to compile against: the two binding files,
    // build.zig for the module definition, and the licence. Examples, the
    // template and the test script stay in the repo rather than in every
    // dependent's cache.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "wasmcart.zig",
        "wasmcart_gl.zig",
        "LICENSE",
    },
}
